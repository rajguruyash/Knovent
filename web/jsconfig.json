{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ],
    "typeRoots": [
      "./node_modules/@types"
    ],
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "api/**/*.js",
    "scripts/build.mjs"
  ],
  "exclude": [
    "node_modules",
    "../node_modules",
    "../../node_modules",
    "../../../node_modules"
  ]
}